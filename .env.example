# Modulo contatti (app/api/contact/route.ts)
# Casella che riceve i messaggi del modulo
CONTACT_TO_EMAIL=
# Mittente verificato presso il servizio di invio (es. "Sito Vestiamico <sito@vestiamico.it>")
CONTACT_FROM_EMAIL=
# Chiave API di Resend (https://resend.com). Senza chiave: in sviluppo il messaggio viene
# scritto nella console del server, in produzione il modulo risponde con un errore e invita a usare WhatsApp.
RESEND_API_KEY=
